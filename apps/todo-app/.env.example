# PostgreSQL Database Connection
# Replace with your actual database URL
# 
# Examples:
# - Local: postgresql://postgres:password@localhost:5432/todos
# - Render: postgresql://user:password@host.render.com/database
# - Neon: postgresql://user:password@host.neon.tech/database
# - Supabase: postgresql://user:password@host.supabase.co/database
#
# Note: Cloud providers (Render, Neon, Supabase) automatically use SSL
DATABASE_URL=postgresql://postgres:password@localhost:5432/todos

# Server port
PORT=3000

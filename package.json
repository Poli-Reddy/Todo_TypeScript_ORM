{
  "name": "lightweight-ts-orm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev:backend": "npm run dev --workspace=apps/todo-app",
    "dev:frontend": "npm run dev --workspace=apps/todo-app/frontend"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
